# ATLAS_MANTRA Environment Variables
#
# SECURITY MODEL:
#   POSTGRES_OWNER: Database owner. Migration only. NEVER used by app.
#   DB_APP_USER: Application role. SELECT + INSERT only.

# ============================================================================
# PostgreSQL - Owner Role (Migration Only)
# ============================================================================
POSTGRES_OWNER=mantra_owner
POSTGRES_OWNER_PASSWORD=CHANGE_THIS_OWNER_PASSWORD
POSTGRES_DB=atlas_mantra
POSTGRES_PORT=5432

# ============================================================================
# PostgreSQL - Application Role (Runtime)
# ============================================================================
# CRITICAL: App MUST use this role, NOT the owner role.
# This role has SELECT + INSERT only. No UPDATE. No DELETE.
DB_APP_USER=mantra_app
DB_APP_PASSWORD=CHANGE_THIS_APP_PASSWORD

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_DOCS=true

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8001
