# ATLAS_MANTRA Environment Variables
#
# SECURITY MODEL:
#   POSTGRES_OWNER: Database owner. Migration only. NEVER used by app.
#   DB_APP_USER: Application role. SELECT + INSERT only.

# ============================================================================
# PostgreSQL - Owner Role (Migration Only)
# ============================================================================
POSTGRES_OWNER=mantra_owner
POSTGRES_OWNER_PASSWORD=CHANGE_THIS_OWNER_PASSWORD
POSTGRES_DB=atlas_mantra
POSTGRES_PORT=5432

# ============================================================================
# PostgreSQL - Application Role (Runtime)
# ============================================================================
# CRITICAL: App MUST use this role, NOT the owner role.
# This role has SELECT + INSERT only. No UPDATE. No DELETE.
DB_APP_USER=mantra_app
DB_APP_PASSWORD=CHANGE_THIS_APP_PASSWORD

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_DOCS=true

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8001

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE=redis
CACHE_TTL=300

# ============================================================================
# Meilisearch Configuration
# ============================================================================
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=CHANGE_THIS_MEILISEARCH_KEY
MEILISEARCH_INDEX_DECISIONS=mantra_decisions
MEILI_ENV=development

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=mantra
RABBITMQ_PASSWORD=CHANGE_THIS_RABBITMQ_PASSWORD
RABBITMQ_VHOST=mantra
RABBITMQ_URL=amqp://mantra:CHANGE_THIS_RABBITMQ_PASSWORD@localhost:5672/mantra
RABBITMQ_EXCHANGE=mantra_events
RABBITMQ_QUEUE_VALIDATION=mantra_validation
RABBITMQ_QUEUE_SYNC=mantra_sync

# ============================================================================
# Qdrant Configuration (Vector Database)
# ============================================================================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mantra_decisions
VECTOR_STORE=memory

# ============================================================================
# Feature Flags
# ============================================================================
# Enable/disable additional services
FEATURE_REDIS_ENHANCED_CACHE=true
FEATURE_MEILISEARCH_ENABLED=false
FEATURE_RABBITMQ_ENABLED=false
ENABLE_SEMANTIC_SEARCH=true

# ============================================================================
# AI/Embedding Configuration
# ============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_SERVICE=noop
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
