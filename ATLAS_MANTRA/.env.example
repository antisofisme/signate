# ATLAS_MANTRA Environment Configuration
# Copy to .env and fill in values

# PostgreSQL - Owner Role (Migrations only)
POSTGRES_OWNER=mantra_owner
POSTGRES_OWNER_PASSWORD=change_me_owner_password
POSTGRES_DB=atlas_mantra
POSTGRES_PORT=5433

# Application Role (Runtime - SELECT + INSERT only)
DB_APP_USER=mantra_app
DB_APP_PASSWORD=change_me_app_password

# Backend
BACKEND_PORT=8001
LOG_LEVEL=INFO
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://31.97.111.175:3001

# Frontend
FRONTEND_PORT=3001
VITE_API_URL=http://31.97.111.175:8001
