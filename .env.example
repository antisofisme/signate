# =============================================================================
# SMART TV DIGITAL SIGNAGE - ENVIRONMENT VARIABLES
# =============================================================================
# Copy file ini ke .env dan sesuaikan dengan environment Anda
# cp .env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://signage_user:your_password_here@postgres:5432/signage_db
POSTGRES_USER=signage_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=signage_db

# =============================================================================
# ANTHIAS CONFIGURATION (Digital Signage Platform)
# =============================================================================
# URL ke Anthias service (internal Docker network atau external)
ANTHIAS_API_URL=http://anthias:8080
# API key dari Anthias (jika diperlukan)
ANTHIAS_API_KEY=

# =============================================================================
# FIREBIRD API CONFIGURATION (External Hotel Guest API)
# =============================================================================
# URL ke Firebird API untuk fetch data tamu hotel
FIREBIRD_API_URL=https://your-hotel-api.com/api/guests
# API Key untuk authenticate ke Firebird
FIREBIRD_API_KEY=your_firebird_api_key_here
# Interval refresh data dari Firebird (dalam detik)
FIREBIRD_REFRESH_INTERVAL=300

# =============================================================================
# REDIS CONFIGURATION (Cache & Session)
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Host & Port untuk Backend API
API_HOST=0.0.0.0
API_PORT=8000
# Debug mode (True untuk development, False untuk production)
DEBUG=True
# Environment (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Secret Key (WAJIB diubah di production!)
# Generate dengan: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
# Token expiry time
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key untuk sensitive data (Firebird API key, dll)
# Generate dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins (comma separated)
# Development: http://localhost:3000,http://192.168.1.100:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# WEB ADMIN FRONTEND CONFIGURATION
# =============================================================================
# URL ke Backend API (untuk Web Admin frontend)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# =============================================================================
# WEBOS TV APP CONFIGURATION
# =============================================================================
# URL ke Backend API (hardcoded di app atau config file)
WEBOS_API_URL=http://192.168.1.50:8000
WEBOS_WS_URL=ws://192.168.1.50:8000/ws

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
# Domain name (untuk production dengan SSL)
DOMAIN_NAME=yourdomain.com
# SSL/TLS
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Max file size untuk upload (dalam bytes)
# 100MB = 104857600 bytes
MAX_UPLOAD_SIZE=104857600
# Allowed file types (comma separated)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Log format
LOG_FORMAT=json
# Log file path (jika ingin save ke file)
LOG_FILE_PATH=/var/log/signage/app.log

# =============================================================================
# MONITORING & HEALTH CHECK
# =============================================================================
# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60
# Device heartbeat timeout (seconds)
DEVICE_HEARTBEAT_TIMEOUT=300

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit per device (requests per minute)
RATE_LIMIT_PER_DEVICE=60
# Rate limit per IP (requests per minute)
RATE_LIMIT_PER_IP=100

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache TTL (Time To Live) dalam detik
CACHE_PLAYLIST_TTL=300
CACHE_GUEST_INFO_TTL=300
CACHE_CONTENT_METADATA_TTL=900

# =============================================================================
# INITIAL ADMIN USER (untuk seeding database)
# =============================================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_password

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable API documentation (Swagger/ReDoc)
ENABLE_API_DOCS=True
# Enable CORS (untuk development)
ENABLE_CORS=True
# Enable hot reload
ENABLE_HOT_RELOAD=True

# =============================================================================
# BACKUP CONFIGURATION (Optional)
# =============================================================================
# Backup path
BACKUP_PATH=/backups
# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# =============================================================================
# TIMEZONE
# =============================================================================
TZ=Asia/Jakarta
