# ATLAS_CHAT_AI Environment Configuration

# =============================================================================
# APP SETTINGS
# =============================================================================
APP_NAME=ATLAS_CHAT_AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8003

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Option 1: URL
DATABASE_URL=postgresql://chat:password@localhost:5432/atlas_chat

# Option 2: Individual settings
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=atlas_chat
# DB_USER=chat
# DB_PASSWORD=password
# DB_MIN_CONN=5
# DB_MAX_CONN=20

# =============================================================================
# REDIS
# =============================================================================
# Option 1: URL
REDIS_URL=redis://localhost:6379/0

# Option 2: Individual settings
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_PREFER_GRPC=false

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=sk-...
# OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=30
RATE_LIMIT_SEARCH=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_ADMIN=10
