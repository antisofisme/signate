# =============================================================================
# SMART TV DIGITAL SIGNAGE - BACKEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update values for your environment
# =============================================================================

# =============================================================================
# ENVIRONMENT & DEBUG
# =============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://192.168.5.12:8001

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://signage_user:your_password_here@postgres:5432/signage_db
POSTGRES_USER=signage_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=signage_db
POSTGRES_EXTERNAL_PORT=5433

# =============================================================================
# REDIS (Cache & Message Broker)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional: Set password for Redis authentication
REDIS_URL=redis://redis:6379
# SECURITY: External port removed from docker-compose.yml for security
# Redis is only accessible within Docker network
# REDIS_EXTERNAL_PORT=6379  # Commented out - only for debugging

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_DEFAULT_RETRY_DELAY=60
CELERY_LOGLEVEL=info
CELERY_CONCURRENCY=4
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=10

# =============================================================================
# FLOWER (Celery Monitoring)
# =============================================================================
FLOWER_EXTERNAL_PORT=5555
# SECURITY: Change default credentials in production!
FLOWER_USER=admin
FLOWER_PASSWORD=  # REQUIRED: Set strong password (min 12 chars)

# =============================================================================
# ANTHIAS INTEGRATION
# =============================================================================
ANTHIAS_API_URL=http://192.168.5.12:8000
ANTHIAS_INTERNAL_URL=http://anthias-nginx
ANTHIAS_PUBLIC_URL=http://192.168.5.12:8000
ANTHIAS_API_KEY=
ANTHIAS_HOME=/data
ANTHIAS_LISTEN=0.0.0.0
ANTHIAS_EXTERNAL_PORT=8000

# =============================================================================
# HLS TRANSCODING
# =============================================================================
HLS_BASE_DIR=/data/hls
HLS_SEGMENT_DURATION=6
HLS_QUALITY_LEVELS=1080p,720p,480p,360p
HLS_AUTO_TRANSCODE=True

# =============================================================================
# SECURITY (IMPORTANT: Change these in production!)
# =============================================================================
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
JWT_SECRET=your-jwt-secret-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-encryption-key-change-in-production-32chars

# =============================================================================
# CORS (Comma-separated list)
# =============================================================================
ENABLE_CORS=True
CORS_ORIGINS=http://localhost:3000,http://192.168.5.12:3000,http://localhost:8080,http://192.168.5.12:8080,http://localhost:8000,http://192.168.5.12:8000,http://192.168.5.12:8001,webos-local://

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_UPLOAD_SIZE=104857600
DATA_DIRECTORY=/data
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime

# =============================================================================
# FIREBIRD API (External PMS)
# =============================================================================
FIREBIRD_API_URL=
FIREBIRD_API_KEY=
FIREBIRD_REFRESH_INTERVAL=300

# =============================================================================
# CACHE TTL (seconds)
# =============================================================================
CACHE_PLAYLIST_TTL=300
CACHE_GUEST_INFO_TTL=300
CACHE_CONTENT_METADATA_TTL=900

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_DEVICE=60
RATE_LIMIT_PER_IP=100

# =============================================================================
# MONITORING & HEALTH
# =============================================================================
HEALTH_CHECK_INTERVAL=60
DEVICE_HEARTBEAT_TIMEOUT=300

# =============================================================================
# DOCKER
# =============================================================================
BACKEND_EXTERNAL_PORT=8001
VIEWER_EXTERNAL_PORT=8080
DOCKER_NETWORK_NAME=signage-network
DOCKER_NETWORK_DRIVER=bridge

# =============================================================================
# DEVELOPMENT
# =============================================================================
ENABLE_API_DOCS=True
ENABLE_HOT_RELOAD=True

# =============================================================================
# FEATURES & ANALYTICS
# =============================================================================
ENABLE_ANALYTICS=True
ENABLE_RATE_LIMITING=True

# =============================================================================
# ERROR TRACKING (Optional)
# =============================================================================
SENTRY_DSN=  # Optional: Sentry DSN for error tracking
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1