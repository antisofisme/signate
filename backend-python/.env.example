# =============================================================================
# BACKEND PYTHON - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in the values
# All microservices in backend-python use this single .env file
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# Database (Shared by all services)
DATABASE_URL=postgresql://signage_user:signage_pass@localhost:5433/signage_db

# Redis (Shared cache & Celery broker)
REDIS_URL=redis://localhost:6379/0
REDIS_MASTER_NAME=mymaster

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://192.168.5.12:3000,http://192.168.5.12:8080

# API Documentation
ENABLE_API_DOCS=true

# Service Ports (if running separately)
AUTH_SERVICE_PORT=8001
TENANT_SERVICE_PORT=8002
DEVICE_SERVICE_PORT=8003
CONTENT_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=Asia/Jakarta
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_CLEANUP_HOUR=3
CELERY_CLEANUP_MINUTE=0

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=100

# External Services
ANTHIAS_API_URL=http://192.168.5.12:8000

# Cache Configuration
CACHE_DEFAULT_TTL=300

# ClamAV Virus Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# FFprobe Metadata Extraction
FFPROBE_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
