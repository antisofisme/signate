# Player Viewer Environment Configuration
# Copy this file to .env and update with your values
# Then run: ./generate-config.sh

# API Configuration
VIEWER_API_URL=http://192.168.5.12:8001
VIEWER_WEBSOCKET_URL=ws://192.168.5.12:8001

# Polling & Intervals (in milliseconds)
VIEWER_POLLING_INTERVAL=30000
VIEWER_HEARTBEAT_INTERVAL=30000
VIEWER_ACTIVATION_POLL_INTERVAL=2000
VIEWER_ACTIVATION_POLL_FAST_INTERVAL=5000
VIEWER_REGISTRATION_RETRY_INTERVAL=60000
VIEWER_CONTENT_REFRESH_INTERVAL=60000
VIEWER_PLAYLIST_CHECK_INTERVAL=60000
VIEWER_SPEEDTEST_INTERVAL=300000

# Retry & Timeout (in milliseconds)
VIEWER_RETRY_INTERVAL=10000
VIEWER_PLAYER_RETRY_INTERVAL=5000
VIEWER_TOAST_DURATION=5000
VIEWER_COMMAND_TIMEOUT=30000
VIEWER_HLS_MANIFEST_TIMEOUT=10000
VIEWER_HLS_LEVEL_TIMEOUT=10000

# WebSocket Configuration (in milliseconds)
VIEWER_WEBSOCKET_MAX_RECONNECT_DELAY=30000
VIEWER_WEBSOCKET_HEARTBEAT_INTERVAL=30000

# Reset Configuration
VIEWER_RESET_PASSWORD=admin123

# Environment
ENVIRONMENT=production
