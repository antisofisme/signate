# Minimal Storage Server Dockerfile (Backend Only - No Frontend Build)
# vim: ft=dockerfile

FROM debian:bookworm

# Install system dependencies
RUN apt-get update && \
    apt-get -y install --no-install-recommends \
        build-essential \
        curl \
        ffmpeg \
        git \
        libffi-dev \
        libssl-dev \
        libzmq3-dev \
        libzmq5-dev \
        libzmq5 \
        net-tools \
        procps \
        psmisc \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-simplejson \
        python-is-python3 \
        sudo \
        sqlite3 && \
    rm -rf /var/lib/apt/lists/*

# Works around issue with `curl`
# https://github.com/balena-io-library/base-images/issues/562
RUN c_rehash

# Install pip and wheel
RUN pip3 install --upgrade pip --break-system-packages && \
    pip3 install wheel --break-system-packages

# Install Python dependencies from local wheels (FAST) with online fallback
COPY vendor/wheels /tmp/wheels
COPY requirements/requirements.txt /tmp/requirements.txt
RUN pip3 install --find-links=/tmp/wheels -r /tmp/requirements.txt --break-system-packages && \
    rm -rf /tmp/wheels

# Copy application code
RUN mkdir -p /usr/src/app
COPY . /usr/src/app/
WORKDIR /usr/src/app

# Create staticfiles directory (Django collectstatic)
RUN mkdir -p /usr/src/app/staticfiles

# Environment variables
ENV GIT_HASH=prod-build-latest
ENV GIT_SHORT_HASH=prod-bf
ENV GIT_BRANCH=production
ENV DEVICE_TYPE=x86
ENV PYTHONUNBUFFERED=1

# Start server
CMD ["bash", "bin/start_server.sh"]
