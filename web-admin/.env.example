# =============================================================================
# WEB ADMIN - ENVIRONMENT CONFIGURATION (Vite)
# =============================================================================
# Environment variables for web-admin React application
# Note: All variables must be prefixed with VITE_ to be accessible in the app
#
# Usage:
#   - Development: npm run dev (reads this file automatically)
#   - Production: npm run build (bundles these values into the app)
#
# IMPORTANT: After changing these values:
#   1. Restart the dev server (npm run dev)
#   2. For production: rebuild (npm run build)
# =============================================================================

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API Base URL
# Example: http://192.168.5.12:8001 or http://localhost:8001
VITE_API_URL=http://localhost:8001

# WebSocket URL for real-time updates
# Example: ws://192.168.5.12:8001 or ws://localhost:8001
VITE_WS_URL=ws://localhost:8001

# Anthias CMS URL (legacy integration)
# Example: http://192.168.5.12:8000
VITE_ANTHIAS_URL=http://localhost:8000

# =============================================================================
# POLLING & INTERVALS (milliseconds)
# =============================================================================
# Dashboard refresh interval (default: 30 seconds)
VITE_DASHBOARD_REFRESH_INTERVAL=30000

# Device status polling interval (default: 10 seconds)
VITE_DEVICE_STATUS_POLL_INTERVAL=10000

# Logs polling interval (default: 5 seconds)
VITE_LOGS_POLL_INTERVAL=5000

# Heartbeat check interval (default: 5 seconds)
VITE_HEARTBEAT_INTERVAL=5000

# =============================================================================
# TIMEOUTS (milliseconds)
# =============================================================================
# API request timeout (default: 30 seconds)
VITE_REQUEST_TIMEOUT=30000

# WebSocket reconnect interval (default: 3 seconds)
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable speed test feature for devices
VITE_ENABLE_SPEEDTEST=true

# Enable activity logs tracking
VITE_ENABLE_ACTIVITY_LOGS=true

# Enable Firebird PMS integration
VITE_ENABLE_FIREBIRD=true

# =============================================================================
# DEBUG & DEVELOPMENT
# =============================================================================
# Enable API response debugging (logs unwrapping process)
# Set to 'true' to see console logs during API format transition
# IMPORTANT: Set to 'false' in production
VITE_DEBUG_API=false

# =============================================================================
# APPLICATION INFO
# =============================================================================
# Application display name
VITE_APP_NAME=Smart TV Digital Signage Admin

# Application version
VITE_APP_VERSION=1.0.0