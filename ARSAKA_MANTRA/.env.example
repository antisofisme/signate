# ATLAS_MANTRA Environment Configuration
# Copy to .env and fill in values

# PostgreSQL - Owner Role (Migrations only)
POSTGRES_OWNER=mantra_owner
POSTGRES_OWNER_PASSWORD=change_me_owner_password
POSTGRES_DB=atlas_mantra
POSTGRES_PORT=5433

# Application Role (Runtime - SELECT + INSERT only)
DB_APP_USER=mantra_app
DB_APP_PASSWORD=change_me_app_password

# Backend
BACKEND_PORT=8001
LOG_LEVEL=INFO
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://31.97.111.175:3001

# Frontend
FRONTEND_PORT=3001
VITE_API_URL=http://31.97.111.175:8001

# ============================================================================
# Additional Services (Optional)
# ============================================================================

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE=memory

# Meilisearch Configuration
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_DECISIONS=mantra_decisions

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=mantra_events
RABBITMQ_QUEUE_VALIDATION=mantra_validation
RABBITMQ_QUEUE_SYNC=mantra_sync

# Vector Store Configuration
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mantra_decisions

# Feature Flags (set to true to enable)
FEATURE_REDIS_ENHANCED_CACHE=true
FEATURE_MEILISEARCH_ENABLED=false
FEATURE_RABBITMQ_ENABLED=false
ENABLE_SEMANTIC_SEARCH=true

# AI/Embedding Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_SERVICE=noop
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
